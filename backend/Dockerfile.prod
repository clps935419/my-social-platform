# Production runtime image
# 
# IMPORTANT: Due to network restrictions in CI/sandboxed environments,
# this Dockerfile expects a pre-built JAR file.
#
# To build the JAR:
#   Option 1: Build locally with Maven
#     cd backend && mvn clean package -DskipTests
#   
#   Option 2: Build with dev container (has Maven dependencies cached)
#     docker compose up app
#     docker compose exec app mvn package -DskipTests
#     docker compose cp app:/app/target/social-platform-0.0.1-SNAPSHOT.jar backend/target/
#
# Then copy target/*.jar to this location before building the image.

FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy pre-built JAR from target directory
COPY target/*.jar app.jar

# Expose port
EXPOSE 8080

# Run as non-root user for security
RUN addgroup -S spring && adduser -S spring -G spring && \
    chown spring:spring app.jar
USER spring:spring

# Run the JAR file
ENTRYPOINT ["java", "-jar", "app.jar"]
